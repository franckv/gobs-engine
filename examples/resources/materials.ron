MaterialsConfig(
    default: (
        // must match material pass layout
        object_layout: [
            WorldMatrix,
            VertexBufferAddress,
        ],
        scene_layout: [
            CameraPosition,
            CameraViewProj,
            LightDirection,
            LightColor,
            LightAmbientColor,
        ],
        vertex_attributes: "POSITION | COLOR | TEXTURE | NORMAL | TANGENT | BITANGENT",
        color_format: R16g16b16a16Sfloat,
        depth_format: D32Sfloat,
    ),
    materials: {
        "color": (
            vertex_shader: "color.spv",
            vertex_entry: "vertex_main",
            fragment_shader: "color.spv",
            fragment_entry: "fragment_main",
            scene_layout: [
                CameraViewProj,
            ],
        ),
        "color.material": (
            vertex_shader: "color_mat.spv",
            vertex_entry: "vertex_main",
            fragment_shader: "color_mat.spv",
            fragment_entry: "fragment_main",
            material_layout: [
                DiffuseColor,
                EmissionColor
            ]
        ),
        "color.light": (
            vertex_shader: "color_light.spv",
            vertex_entry: "vertex_color_light_main",
            fragment_shader: "color_light.spv",
            fragment_entry: "fragment_color_light_main",
        ),
        "color.transparent": (
            vertex_shader: "color.spv",
            vertex_entry: "vertex_main",
            fragment_shader: "color.spv",
            fragment_entry: "fragment_main",
            blend_mode: Alpha,
            scene_layout: [
                CameraViewProj,
            ],
        ),
        "texture": (
            vertex_shader: "mesh.spv",
            vertex_entry: "vertex_main",
            fragment_shader: "mesh.spv",
            fragment_entry: "fragment_main",
            texture_layout: [
                Diffuse,
            ],
        ),
        "texture.transparent": (
            vertex_shader: "mesh.spv",
            vertex_entry: "vertex_main",
            fragment_shader: "mesh.spv",
            fragment_entry: "fragment_main",
            blend_mode: Alpha,
            texture_layout: [
                Diffuse,
            ],
        ),
        "normal": (
            vertex_shader: "mesh.spv",
            vertex_entry: "vertex_main",
            fragment_shader: "mesh.spv",
            fragment_entry: "fragment_normal_main",
            texture_layout: [
                Diffuse,
                Normal
            ],
        ),
        "normal.array": (
            vertex_shader: "mesh_array.spv",
            vertex_entry: "vertex_main",
            fragment_shader: "mesh_array.spv",
            fragment_entry: "fragment_normal_main",
            texture_indexing: true,
            texture_layout: [
                Diffuse,
                Normal
            ],
            material_layout: [
                EmissionColor
            ],
        ),
        "depth": (
            vertex_shader: "color.spv",
            vertex_entry: "vertex_main",
            fragment_shader: "color.spv",
            fragment_entry: "depth_fragment_main",
            scene_layout: [
                CameraViewProj,
            ],
        ),
    }
)
