PipelinesConfig(
    compute_pipelines: {},
    graphics_pipelines: {
       "depth": (
            vertex_shader: (
                file: "depth.spv",
                entry: "main",
            ),
            object_layout: [
                WorldMatrix,
                VertexBufferAddress,
            ],
            vertex_attributes: "POSITION | COLOR | TEXTURE | NORMAL | TANGENT | BITANGENT",
            bindings: [
            (
                    group: SceneData,
                    stage: Vertex,
                    descriptor_type: Uniform
            ),
            ],
            polygon_mode: Fill,
            attachments: (
                depth_format: D32Sfloat,
            ),
            depth_test: (
                enable: true,
                write_enable: true,
                compare: Less,
            ),
            cull_mode: Back,
            front_face: CCW,
        )
    }
)

